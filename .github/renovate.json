{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>UnstoppableMango/renovate-config",
    "github>UnstoppableMango/renovate-config:gomod2nix(.)"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["tools/update/go.mod"],
      "postUpgradeTasks": {
        "workingDirTemplate": "tools/update"
      }
    }
  ]
}
